# QSP self-hosting example configuration.
# Copy to .env (cp .env.example .env). Defaults are for a LOCAL TRIAL ONLY:
# do not expose this stack to the internet with these passwords.

# Public host name and port the browser and agents use to reach QSP.
# Everything (web, /auth, /signaling) is served from http://QSP_HOST:QSP_PORT.
QSP_HOST=localhost
QSP_PORT=8080

# PostgreSQL superuser password (single shared database "qsp").
POSTGRES_PASSWORD=pgpass

# Seeded admin account: user "admin". Its password is set by the migrations and
# must be supplied by the QSP maintainer; there is no admin password setting here.
# TODO(maintainer): document the seeded admin password.

# Image versions.
# TODO(maintainer): these default to "latest" because no suitable released tags
# exist yet. Pin them to released versions (e.g. 0.2.0) once releases are cut,
# so that "docker compose up" stays reproducible.
QSP_WEB_VERSION=latest
QSP_AUTH_VERSION=latest
QSP_SIGNALING_VERSION=latest
